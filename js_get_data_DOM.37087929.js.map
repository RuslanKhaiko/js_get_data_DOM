var populationElements = document.querySelectorAll('span.population');
var total = 0;
var count = 0;
populationElements.forEach(function(element) {
    var numberString = element.textContent.replace(/,/g, '');
    var number = parseFloat(numberString);
    if (!isNaN(number)) {
        total += number;
        count++;
    }
});
var average = total / count;
var totalFormatted = total.toLocaleString();
var averageFormatted = average.toLocaleString();
document.querySelector('.total-population').textContent = totalFormatted;
document.querySelector('.average-population').textContent = averageFormatted;

